# Salin file ini menjadi ".env" lalu isi nilainya.
# Jangan pernah mengunggah file .env ke penyimpanan bersama (sudah masuk .gitignore).

# Port server web
PORT=3000

# Alamat dasar yang dipakai pada QR Code (ganti dengan alamat server Anda)
BASE_URL=http://localhost:3000

# Kata sandi untuk halaman /admin
ADMIN_PASSWORD=ganti-dengan-kata-sandi-admin

# Kunci rahasia untuk menandai sesi login (isi dengan teks acak panjang)
SECRET_TOKEN=ganti-dengan-kunci-acak-yang-panjang

# ------------------------------------------------------------
# PIN CABANG — format: PIN_CABANG_<kode cabang>
# Kode cabang ada di data/master.js (misalnya RM_A_C1).
# PIN ini dibaca dari file .env, bukan ditulis di dalam kode.
# ------------------------------------------------------------
PIN_CABANG_RM_A_C1=1111
PIN_CABANG_RM_A_C2=2222
PIN_CABANG_RM_B_C1=3333
PIN_CABANG_RM_B_C2=4444
